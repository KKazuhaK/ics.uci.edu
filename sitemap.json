    {
      "path": "/about.html",
      "title": "About Me",
      "description": "Personal biography, background, and contact information for Kazuha Mo.",
      "category": "main",
      "content": {
        "name": "Kazuha Mo",
        "degree": "B.S. Computer Science",
        "school": "University of California, Irvine",
        "email": "kazuhak@uci.edu",
        "bio": [
          "I enjoy technology, the web, and building practical things people actually use. I like exploring how simple ideas become useful tools, clean interfaces, and small projects that make everyday tasks easier.",
          "This site is my personal space on the web — where I share a bit about myself, experiment with ideas, and collect the projects I care about. I prefer work that feels straightforward, thoughtful, and quietly useful.",
          "Outside of classes, I'm drawn to personal projects, online services, and creating spaces that feel organized and meaningful. Over time, this site will continue to grow into a home for my tools, experiments, and things I want to keep building."
        ],
        "links": {
          "github": "https://github.com/KKazuhaK",
          "website": "https://www.kazuhahub.com"
        }
      }
    },
