    "marked": "15.0.7",
    "marked-footnote": "1.4.0",
    "mermaid": "11.17.2",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
