---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ABOUT } from "../data/about";

const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, "");
---

<BaseLayout title="About" description="Kazuha Mo — B.S. Computer Science, UC Irvine. Bio, focus areas, and links.">
  <main class="page about-grid">
    <div class="card about-hero">
      <div class="about-blob"></div>
      <div class="eyebrow" style="color:rgba(255,255,255,0.7);position:relative;">About</div>
      <h1 class="about-title">{ABOUT.name}</h1>
      <p class="about-role">{ABOUT.degree} · {ABOUT.school}</p>
      <div class="about-chips">
        <a class="chip-link" href={`mailto:${ABOUT.email}`}>{ABOUT.email}</a>
        <a class="chip-link" href={ABOUT.links.github} target="_blank" rel="noopener">{host(ABOUT.links.github)}</a>
        <a class="chip-link" href={ABOUT.links.website} target="_blank" rel="noopener">{host(ABOUT.links.website)}</a>
      </div>
    </div>

    <div class="card about-bio">
      <div class="eyebrow">Bio</div>
      {ABOUT.bio.map((p) => <p>{p}</p>)}
    </div>

    <div class="card dark-card about-quote">
      <div class="eyebrow">Guiding line</div>
      <blockquote>"{ABOUT.quote.text}"</blockquote>
      <div style="font-size:12px;opacity:0.75;margin-top:10px;">— {ABOUT.quote.source}</div>
    </div>
  </main>
</BaseLayout>
