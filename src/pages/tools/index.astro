---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TOOLS } from "../../data/tools";
import { url } from "../../lib/urls";

const beta = TOOLS.filter((t) => t.beta).length;
---

<BaseLayout title="Tools" description="Small browser-based tools — markdown viewer, editor, code runner, Ask AI, speed test.">
  <main class="page tools-page">
    <div class="page-head card">
      <div class="eyebrow">Tools</div>
      <h1 class="page-title">Small tools that do one thing well.</h1>
      <p class="page-sub">A growing shelf of browser-based utilities. Nothing to install — open and use.</p>
      <div class="page-stats">
        <div><div class="stat-n">{TOOLS.length}</div><div class="stat-l">Live tools</div></div>
        <div><div class="stat-n">{beta}</div><div class="stat-l">In beta</div></div>
        <div><div class="stat-n">0</div><div class="stat-l">Installs needed</div></div>
        <div><div class="stat-n">∞</div><div class="stat-l">Free forever</div></div>
      </div>
    </div>

    <div class="tools-list">
      {TOOLS.map((t) => (
        <a href={url(`tools/${t.slug}/`)} class="card interactive tool-card">
          <div class="tool-glyph-big" style={`color:${t.color};background:${t.color}21;`}>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
          </div>
          <div class="tool-body">
            <div class="tool-row-top"><div class="tool-card-name">{t.name}</div>{t.beta && <span class="tool-tag">Beta</span>}</div>
            <div class="card-desc" style="margin-top:6px;">{t.desc}</div>
          </div>
          <div class="tool-arrow">→</div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
