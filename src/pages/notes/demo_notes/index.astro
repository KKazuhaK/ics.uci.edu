---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { DEMO_COURSES, visibleWeeks } from "../../../data/demos";
import { url } from "../../../lib/urls";
---

<BaseLayout title="LA/TA Demo Notes" description="Interactive teaching demos for LA/TA sessions — visual, step-by-step walkthroughs to help students understand key concepts.">
  <main class="page notes-page">
    <div class="page-head card">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={url("notes/")} class="crumb">Notes</a>
        <span class="crumb-sep">›</span>
        <span class="crumb crumb-current">Demo Notes</span>
      </nav>
      <h1 class="page-title">LA / TA demos.</h1>
      <p class="page-sub">Interactive teaching demos for LA / TA sessions — visual, step-by-step walkthroughs to help students understand key concepts.</p>
    </div>

    <div class="section-head">
      <div class="eyebrow">Browse by course</div>
      <span class="section-meta">{DEMO_COURSES.length} course{DEMO_COURSES.length === 1 ? "" : "s"} · more soon</span>
    </div>

    <div class="notes-grid demo-grid">
      {DEMO_COURSES.map((c) => (
        <a href={url(`notes/demo_notes/${c.code}/`)} class="card interactive">
          <span class="eyebrow-pill">Demo</span>
          <div class="card-title" style="margin-top:10px;">{c.name}</div>
          <div class="card-desc">{c.cardDesc}</div>
          <div class="card-meta" style="margin-top:12px;">{visibleWeeks(c).length} walkthroughs →</div>
        </a>
      ))}
      <div class="card muted-card">
        <div class="eyebrow">More soon</div>
        <div class="card-desc" style="margin-top:10px;">More course demos will appear here over time.</div>
      </div>
      <div class="card muted-card">
        <div class="eyebrow">Request a demo</div>
        <div class="card-desc" style="margin-top:10px;">If there's a concept you'd like walked through, email me.</div>
        <div class="card-meta" style="margin-top:12px;"><a href="mailto:kazuhak@uci.edu" style="border-bottom:1px dashed currentColor;">kazuhak@uci.edu</a></div>
      </div>
    </div>
  </main>
</BaseLayout>
