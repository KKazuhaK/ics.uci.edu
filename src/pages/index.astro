---
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteLink from "../components/NoteLink.astro";
import { courseSlug, getCourses, getNoteGroups, pickVersion, unitLabel } from "../lib/notes";
import { courseUrl, url } from "../lib/urls";

const courses = await getCourses();
const groups = await getNoteGroups();
const codeToName = new Map(courses.map((c) => [c.data.code, c.data.name]));
const current = new Set(courses.filter((c) => c.data.current).map((c) => c.data.code));
const TONE = { blue: "", navy: "navy", gold: "gold" } as const;

// This term's courses first, then the highest lecture/week numbers.
const recent = [...groups.values()]
  .flat()
  .filter((g) => g.unit !== "special")
  .sort((a, b) =>
    Number(current.has(b.course)) - Number(current.has(a.course)) ||
    (b.number ?? 0) - (a.number ?? 0) ||
    (codeToName.get(a.course) ?? "").localeCompare(codeToName.get(b.course) ?? ""))
  .slice(0, 3);
---

<BaseLayout description="Personal site of Kazuha Mo, a CS student at UC Irvine. Course notes, web tools, and quiet experiments.">
    <main class="page home-grid">
      <div class="card hero">
        <div class="hero-blob-gold"></div>
        <div class="hero-blob-white"></div>
        <div class="hero-top">
          <div class="eyebrow hero-eyebrow">Personal Site · Fall 2026</div>
          <h1 class="hero-title">Building small, <em>useful</em> things on the web.</h1>
          <p class="hero-sub">I'm <strong>Kazuha Mo</strong> — a CS student at UC Irvine. This is where I keep my course notes, web tools, and quiet experiments.</p>
        </div>
        <div class="hero-cta">
          <a href={url("notes/")} class="btn btn-white">Read the notes →</a>
          <a href={url("about.html")} class="btn btn-glass">About me</a>
        </div>
      </div>

      <div class="card-strip">
        <a href={url("notes/")} class="card interactive course-card">
          <span class="eyebrow-pill navy">Notes</span>
          <div>
            <div class="card-title">Notes</div>
            <div class="card-desc">Course notes + LA/TA demos.</div>
          </div>
          <div class="card-meta">{courses.length} courses · EN / 中文</div>
        </a>
        {courses.map((course) => {
          const c = course.data;
          const list = groups.get(c.code) ?? [];
          const numbered = list.filter((g) => g.unit !== "special");
          const latest = numbered.at(-1);
          const lectures = numbered.every((g) => g.unit === "lecture");
          return (
            <a href={courseUrl(courseSlug(c.code))} class="card interactive course-card">
              <span class={`eyebrow-pill ${TONE[c.tone]}`}>Course</span>
              <div>
                <div class="card-title">{c.name}</div>
                <div class="card-desc">{c.short}</div>
              </div>
              <div class="card-meta">{numbered.length} {lectures ? "lectures" : "weeks"}{latest && ` · latest ${lectures ? "L" : "w"}${latest.number}`}</div>
            </a>
          );
        })}
      </div>

      <div class="card recent-card" id="recent-notes-card">
        <div class="eyebrow">Recent notes</div>
        <div class="recent-list" id="recent-notes-list">
          {recent.map((g) => (
            <NoteLink group={g} class="recent-item">
              <div class="recent-meta">
                <span>{codeToName.get(g.course)}</span>
                <span class="recent-dot">·</span><span class="recent-week">{unitLabel(g, "en-US")}</span>
              </div>
              <div class="recent-title">{pickVersion(g, "en-US").note.data.title}</div>
            </NoteLink>
          ))}
        </div>
        <a class="recent-footer" href={url("notes/")}>Browse all notes →</a>
      </div>

      <div class="card say-hi-card">
        <div class="eyebrow">Say hi</div>
        <a href="mailto:kazuhak@uci.edu" class="say-hi-email">kazuhak<wbr/>@uci.edu</a>
        <div class="card-meta" style="margin-top:10px;">Email is fastest. Find me elsewhere below.</div>
        <div class="say-hi-links">
          <a href="https://github.com/KKazuhaK" target="_blank" rel="noopener" class="say-hi-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            GitHub
          </a>
          <a href="https://www.kazuhahub.com" target="_blank" rel="noopener" class="say-hi-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            kazuhahub.com
          </a>
          <a href={url("about.html")} class="say-hi-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            About me
          </a>
        </div>
      </div>

      <div class="card tools-card">
        <div>
          <div class="eyebrow" style="color:rgba(0,0,0,0.6);">Tools · 5</div>
          <div class="tools-title">Small web things I actually use.</div>
        </div>
        <div class="tools-grid">
          <a href={url("tools/md-viewer/")} class="tool-chip"><div class="tool-glyph"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg></div><div class="tool-name">md-viewer</div></a>
          <a href={url("tools/md-editor/")} class="tool-chip"><div class="tool-glyph"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15.707 21.293a1 1 0 0 1-1.414 0l-1.586-1.586a1 1 0 0 1 0-1.414l5.586-5.586a1 1 0 0 1 1.414 0l1.586 1.586a1 1 0 0 1 0 1.414z"/><path d="m18 13-1.375-6.874a1 1 0 0 0-.746-.776L3.235 2.028a1 1 0 0 0-1.207 1.207L5.35 15.879a1 1 0 0 0 .776.746L13 18"/><path d="m2.3 2.3 7.286 7.286"/><circle cx="11" cy="11" r="2"/></svg></div><div class="tool-name">md-editor</div></a>
          <a href={url("tools/code-runner/")} class="tool-chip"><div class="tool-glyph"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg></div><div class="tool-name">code-runner</div></a>
          <a href={url("tools/ask-ai/")} class="tool-chip"><div class="tool-glyph"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg></div><div class="tool-name">ask-ai</div></a>
          <a href={url("tools/speedtest/")} class="tool-chip"><div class="tool-glyph"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg></div><div class="tool-name">speedtest</div></a>
          <a href={url("tools/")} class="tool-chip tool-chip-all"><div class="tool-glyph"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></div><div class="tool-name">All tools</div></a>
        </div>
      </div>

      <a href="https://github.com/KKazuhaK" target="_blank" rel="noopener" class="card interactive heat-card">
        <div class="eyebrow">GitHub</div>
        <div style="font-size:18px;font-weight:700;letter-spacing:-0.3px;margin-top:8px;">@KKazuhaK</div>
        <div class="heatmap" id="gh-heat"></div>
        <div class="card-meta" id="gh-heat-meta" style="margin-top:12px;">Contribution heatmap · last 20 weeks</div>
      </a>
      <script is:inline>
        // Real contribution data via github-contributions-api.jogruber.de (public, CORS-enabled, no token).
        // Grid is row-major (7 weekday rows × 20 week columns) to match .heatmap's 20-column CSS grid.
        // Empty hm-0 cells render immediately so bento.js's mount animation has something to animate;
        // levels are filled in when the fetch resolves, and stay empty if it fails.
        (function () {
          var h = document.getElementById("gh-heat"); if (!h) return;
          var WEEKS = 20, out = "";
          for (var i = 0; i < WEEKS * 7; i++) out += '<div class="hm-cell hm-0"></div>';
          h.innerHTML = out;
          var cells = h.children;

          fetch("https://github-contributions-api.jogruber.de/v4/KKazuhaK?y=last")
            .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(function (data) {
              var days = data.contributions || [];
              var now = new Date();
              var today = now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0") + "-" + String(now.getDate()).padStart(2, "0");
              // Group into Sunday-start weeks, keep the newest WEEKS of them.
              var weeks = [], cur = null;
              days.forEach(function (d) {
                if (!cur || new Date(d.date + "T00:00:00Z").getUTCDay() === 0) weeks.push(cur = []);
                cur.push(d);
              });
              weeks = weeks.slice(-WEEKS);
              var total = 0, filled = [];
              weeks.forEach(function (week, w) {
                week.forEach(function (d) {
                  var cell = cells[new Date(d.date + "T00:00:00Z").getUTCDay() * WEEKS + w];
                  if (!cell || d.date > today) return;
                  filled.push(cell);
                  total += d.count;
                  cell.className = cell.className.replace(/\bhm-\d\b/, "hm-" + d.level);
                  cell.title = d.count + " contribution" + (d.count === 1 ? "" : "s") + " on " + d.date;
                });
              });
              // Days not covered (future days in the current week) shouldn't look like zero-contribution days.
              for (var j = 0; j < cells.length; j++) if (filled.indexOf(cells[j]) < 0) cells[j].style.visibility = "hidden";
              var meta = document.getElementById("gh-heat-meta");
              if (meta) meta.textContent = total + " contributions · last " + WEEKS + " weeks";
            })
            .catch(function () {});
        })();
      </script>
    </main>
</BaseLayout>

<style is:global>
    /* Strip beside the hero: Notes tile + 5 courses in a 3x2 grid */
    .card-strip { grid-template-columns: repeat(3, 1fr); }
    .card-strip > .card { padding: 14px; }
    @media (max-width: 520px) {
      .card-strip { grid-template-columns: 1fr; }
    }

    .recent-card { display: flex; flex-direction: column; gap: 10px; }
    .recent-list { display: flex; flex-direction: column; gap: 6px; margin-top: 2px; }
    .recent-item {
      display: flex; flex-direction: column; gap: 3px;
      padding: 9px 12px; border-radius: 10px;
      background: var(--uci-blue-soft); color: var(--ink);
      text-decoration: none;
      border: 1px solid transparent;
      border-bottom: 1px solid transparent !important;
      transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    }
    .recent-item:hover {
      transform: translateY(-1px);
      border-color: var(--hairline);
      border-bottom-color: var(--hairline) !important;
    }
    .recent-meta {
      display: flex; align-items: center; gap: 6px;
      font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
      text-transform: uppercase; color: var(--uci-blue);
    }
    .recent-meta .recent-dot { opacity: 0.45; }
    .recent-meta .recent-week { font-weight: 500; letter-spacing: 0.5px; opacity: 0.75; }
    .recent-title { font-size: 13.5px; font-weight: 500; line-height: 1.4; color: var(--ink); }
    .recent-skel { font-size: 13px; color: var(--subtle); padding: 6px 0; }
    .recent-footer { font-size: 12px; color: var(--subtle); margin-top: 2px; text-decoration: none; border-bottom: 0 !important; }
    .recent-footer:hover { color: var(--ink); }

    .say-hi-email {
      display: inline-block;
      font-size: 15px; font-weight: 600; letter-spacing: -0.2px;
      margin-top: 10px; color: var(--ink);
      text-decoration: none; border-bottom: 0 !important;
      transition: color 0.2s ease;
    }
    .say-hi-email:hover { color: var(--uci-blue); }
    .say-hi-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
    .say-hi-link {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 11px; border-radius: 999px;
      font-size: 12px; font-weight: 600;
      background: var(--uci-blue-soft); color: var(--uci-blue);
      border: 1px solid transparent;
      border-bottom: 1px solid transparent !important;
      text-decoration: none;
      transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    }
    .say-hi-link:hover {
      transform: translateY(-1px);
      border-color: var(--hairline);
      border-bottom-color: var(--hairline) !important;
    }
    .say-hi-link svg { width: 13px; height: 13px; flex-shrink: 0; opacity: 0.85; }

    html[data-theme="dark"] .recent-meta,
    html[data-theme="dark"] .say-hi-link { color: #6aa3f5; }
    html[data-theme="dark"] .say-hi-email:hover { color: #6aa3f5; }
</style>
