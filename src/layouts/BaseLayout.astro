---
// Bento page shell shared by every Astro page: <head>, pill nav, footer,
// bento.js (theme toggle, active nav) and the Ask AI widget.
import { url } from "../lib/urls";

interface Props {
  /** Page name; omitted on the homepage. */
  title?: string;
  description?: string;
  lang?: string;
  /** Section to highlight in the nav when it differs from the URL (e.g. "notes/"). */
  navPath?: string;
}

const { title, description, lang = "en", navPath } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <title>{title ? `${title} | Kazuha Mo — UC Irvine` : "Kazuha Mo — UC Irvine"}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("favicon.ico")} type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={url("assets/css/bento.css")} />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("kzh-theme");
          var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.setAttribute("data-theme", saved || (prefersDark ? "dark" : "light"));
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body data-nav-path={navPath ? url(navPath) : undefined}>
    <div class="app">
      <nav class="nav" aria-label="Primary">
        <div class="nav-brand">
          <a href={url()} class="nav-logo" aria-label="Home">K</a>
          <span class="nav-name">Kazuha Mo</span>
        </div>
        <div class="nav-links">
          <a href={url()} class="nav-link"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>Home</a>
          <a href={url("notes/")} class="nav-link"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h4"></path><path d="M2 10h4"></path><path d="M2 14h4"></path><path d="M2 18h4"></path><rect width="16" height="20" x="4" y="2" rx="2"></rect><path d="M9.5 8h5"></path><path d="M9.5 12h5"></path><path d="M9.5 16H14"></path></svg>Notes</a>
          <a href={url("tools/")} class="nav-link"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>Tools</a>
          <a href={url("about.html")} class="nav-link"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>About</a>
        </div>
        <div class="nav-actions">
          <button class="theme-btn" aria-label="Toggle theme">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
          </button>
        </div>
      </nav>

      <slot />

      <footer class="foot">
        <span>© 2026 Kazuha Hub · Kazuha Mo</span>
        <span>
          Email: <a href="mailto:kazuhak@uci.edu">kazuhak@uci.edu</a>
          ·
          <a href="https://github.com/KKazuhaK" target="_blank" rel="noopener">GitHub</a>
        </span>
      </footer>
    </div>

    <script is:inline src={url("assets/js/bento.js")} defer></script>
    <script is:inline src={url("assets/js/chat-widget.js")} defer></script>
  </body>
</html>
