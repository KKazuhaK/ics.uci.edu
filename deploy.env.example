# Server settings for update_site.sh, scripts/pull-deploy.sh and scripts/deploy.sh.
# These defaults are the UCI ICS server. On another server: cp deploy.env.example
# deploy.env (git-ignored) and change what differs; unset values keep these defaults.
# Sourced by bash, so $HOME works and values with spaces need quotes.

# Branch holding this server's prebuilt site (CI builds it; see deploy/targets.json)
DEPLOY_BRANCH=deploy
# Base path that build was made for ("/" for a site at the domain root)
SITE_BASE=/~kazuhak
# Public URL, only printed after a deploy
PUBLIC_URL=https://ics.uci.edu/~kazuhak/

# Directory the web server serves. Build output only: anything not in KEEP is
# replaced or deleted on every deploy.
WEB_ROOT="$HOME/public_html"
# Paths under WEB_ROOT that are not built from this repo and must be left alone
KEEP="next/ resources/ remote_profiles/ temp/ .venv/ .claude/ .codex CLAUDE.md assets/config/*.local.json"

# Local clone of DEPLOY_BRANCH
DIST_DIR="$HOME/site-dist"
# Cron log, used by ./update_site.sh --install-cron
LOG_FILE="$HOME/.cache/site-pull-deploy.log"
# Cron schedule for ./update_site.sh --install-cron
CRON_SCHEDULE="*/5 * * * *"

# GitHub repo, for the CI status check in update_site.sh (needs gh)
GH_REPO=KKazuhaK/ics.uci.edu
