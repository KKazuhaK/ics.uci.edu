# site-sync.sh config for the UCI ICS server (circinus / openlab, ~kazuhak).
# Install: scripts/site-sync.sh init ics   (copies this to ~/.config/kzh-site/ics.conf)
TARGET=ics
BRANCH=deploy
WEB_ROOT=$HOME/public_html

# Served from ~/public_html but not built from this repo: never touched by a sync.
KEEP=(
  next/
  resources/
  remote_profiles/
  temp/
  .venv/
  .claude/
  .codex
  CLAUDE.md
  "assets/config/*.local.json"
)
