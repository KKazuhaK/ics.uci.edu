RewriteEngine On

# viz components moved from the md-viewer folder to assets/viz/ (Oct 2026); old URLs (notes skill's check_md.py) keep working
RewriteRule ^tools/md-viewer/viz/(.+)$ https://ics.uci.edu/~kazuhak/assets/viz/$1 [R=301,L]

AddType "text/markdown; charset=utf-8" .md

<FilesMatch "^(README(\..*)?|SITE_DOCS\.md|CLAUDE\.md)$">
  Require all denied
</FilesMatch>
